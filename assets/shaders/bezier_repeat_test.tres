[gd_resource type="Shader" format=2]

[resource]
code = "shader_type spatial;
render_mode unshaded, world_vertex_coords;

float circle(vec2 uvc, vec2 pos, float rad) {
    vec2 dist = uvc - pos;
    return 1.0-smoothstep(rad-(rad*0.01), rad+(rad*0.01), dot(dist, dist)*10.0);
}

vec2 createLinearBezier(int i, vec2 p0, vec2 p1) {
    float t = float(i) * 0.01;
    return mix(p0, p1, t);
}


vec2 createBezier(int i, vec2 p0, vec2 p1, vec2 p2) {
    float t = float(i) * 0.01;
    vec2 q0 = mix(p0, p1, t);
    vec2 q1 = mix(p1, p2, t);
    vec2 b = mix(q0, q1, t);
    return b;
}

void fragment() {
    
    vec2 uvc = UV;
    vec2 map_zones = 18.0;
    vec2 map_zone = 1.0 / map_zones;
    vec2 map_uv = floor(uvc * map_zones);
    vec2 map_zone_uv = map_zone * fract(uvc * map_zones);
     
    vec2 p0 = vec2(0.5, 1.0);
    vec2 p1 = vec2(0.5);
    vec2 p2 = vec2(1.0, 0.5);
    vec3 col = vec3(0.0);

    for (int i = 0;i < 100;i++) {
        vec2 b = createBezier(i, p0, p1, p2);
        col += vec3(circle(uvc, b, 0.5));
    }
    ALBEDO = col;
}
"
