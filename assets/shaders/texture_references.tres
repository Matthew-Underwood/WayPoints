[gd_resource type="Shader" format=2]

[resource]
code = "shader_type spatial;
render_mode unshaded, world_vertex_coords;

uniform vec2 map_size1;
uniform vec2 map_size2;
uniform sampler2D path_reference_map1;
uniform sampler2D path_reference_map2;
uniform vec3 path_colour1;
uniform vec3 path_colour2;

float circle(vec2 uvc, vec2 pos, float rad) {
    vec2 dist = uvc - pos;
    return 1.0-smoothstep(rad-(rad*0.01), rad+(rad*0.01), dot(dist, dist)*10.0);
}

vec2 getPointFromLinearLine(int i, vec2 p0, vec2 p1) {
    float t = float(i) * 0.01;
    return mix(p0, p1, t);
}

vec2 getPointFromBezierLine(int i, vec2 p0, vec2 p1, vec2 p2) {
    float t = float(i) * 0.01;
    vec2 q0 = mix(p0, p1, t);
    vec2 q1 = mix(p1, p2, t);
    vec2 b = mix(q0, q1, t);
    return b;
}

vec2 rotate_space(vec2 uv, float deg, vec2 offset) {
	float rad = radians(deg);
	uv = uv - offset;
	mat2 rot = mat2(vec2(cos(rad), sin(rad)), vec2(-sin(rad), cos(rad)));
	uv *= rot;
	uv = uv + offset;
	return uv;
}

float box(vec2 pos, vec2 size, vec2 offset, float deg) {
	pos = rotate_space(pos, deg, vec2(0.5));
	offset = rotate_space(offset, deg, vec2(0.0));
	pos += offset;
	vec2 edge = vec2(0.5) - size * 0.5;
    vec2 uv = smoothstep(edge, edge + vec2(0.001), pos);
    uv *= smoothstep(edge, edge + vec2(0.001), vec2(1.0) - pos);
    return uv.x * uv.y;
}

vec2 get_position_from_id(int id) {

    vec2 pos = vec2(0.0);

    switch(id) {
        case 1: //NW
            pos = vec2(0, 0);
            break;
        case 2: //N
            pos = vec2(0.5, 0);
            break;
        case 4: //NE
            pos = vec2(1.0, 0);
            break;
        case 8: //W
            pos = vec2(0, 0.5);
            break;
        case 16: //E
            pos = vec2(1.0, 0.5);
            break;
        case 32: //SW
            pos = vec2(0.0, 1.0);
            break;
        case 64: //S
            pos = vec2(0.5, 1.0);
            break;
        case 128: //SE
            pos = vec2(1.0);
            break;
    }

    return pos;
}

float create_bezier(vec2 uva, vec2 a, vec2 b, vec2 c) {
    
    float col = 0.0;
    for (int i = 0; i < 100; i++) {
        vec2 bez = getPointFromBezierLine(i, a, b, c);
        col += circle(uva, bez, 0.2);
    }
    return col;
}

float createLinearLine(vec2 fuv, vec2 a, vec2 b) {

    float col = 0.0;
    for (int i = 0; i < 100; i++) {
        vec2 bez = getPointFromLinearLine(i, a, b); 
        col += circle(fuv, bez, 0.2);
    }
    return col;
}

float process_corners(int corners, vec2 uv, vec2 map_size) {

    const int corner_ids[4] = int[4] (128, 32, 4, 1);
    vec2 fuv = fract(uv * map_size);
    float col = 0.0;
    for (int id = 0; id < corner_ids.length(); id++) {

        int corner_id = corner_ids[id];
    
        if (corners >= corner_id) {

            if (corner_id == 128) {
                col += create_bezier(fuv, vec2(2.0, 0.0), vec2(1.0), vec2(0.0, 2.0)); 
            }
            if (corner_id == 32) {
                col += create_bezier(fuv, vec2(-1.0, 0.0), vec2(0.0, 1.0), vec2(1.0, 2.0)); 
            }
            if (corner_id == 4) {
                col += create_bezier(fuv, vec2(0.0, -1.0), vec2(1.0, 0.0), vec2(2.0, 1.0)); 
            }
            if (corner_id == 1) {
                col += create_bezier(fuv, vec2(-1.0, 1.0), vec2(0.0), vec2(1.0, -1.0)); 
            }
            corners -= corner_id;
        }
    }
    return col;
}


float process_directions(int directions, vec2 uv, vec2 map_size) {

    const int direction_ids[8] = int[8] (128, 64, 32, 16, 8, 4, 2, 1);
    vec2 fuv = fract(uv * map_size);
    float col = 0.0;
    int directions_start = directions;

    for (int id = 0; id < direction_ids.length(); id++) {

        int direction_id = direction_ids[id];

        if (directions_start == direction_id) {

            vec2 start_pos = vec2(0.5);
            vec2 end_pos = get_position_from_id(direction_id);
            col += create_bezier(fuv, start_pos, vec2(0.5), end_pos); 
        }
    
        if (directions >= direction_id) {
            
            vec2 start_pos = vec2(0.5);

            if (directions > direction_id) {
                int start_id = direction_id;
                start_pos = get_position_from_id(start_id);
            }
            directions -= direction_id;
            int inner_directions = directions;

            for (int inner_id = 0; inner_id < direction_ids.length(); inner_id++) {
                int inner_direction_id = direction_ids[inner_id];
                if (inner_directions >= inner_direction_id) {
                    int end_id = inner_direction_id;  
                    vec2 end_pos = get_position_from_id(end_id);
                    col += create_bezier(fuv, start_pos, vec2(0.5), end_pos); 
                    inner_directions -= inner_direction_id;
                }
            }
        }
    }
    return col;
}

float path(vec2 uv, sampler2D ref_tex, vec2 map_size) {

    vec4 path_data = texture(ref_tex, uv) * 255.0;
    float col = 0.0;

    col += process_directions(int(path_data.r), uv, map_size); 
    col += process_corners(int(path_data.g), uv, map_size); 
    return col; 
}


void fragment () {

    float path1 = path(UV, path_reference_map1, map_size1); 
    vec3 colour1 = vec3(path1) * path_colour1.rgb;

    ALBEDO = colour1; 

    float path2 = path(UV, path_reference_map2, map_size2); 
    vec3 colour2 = vec3(path2) * path_colour2.rgb;

    if (colour2 != vec3(0.0, 0.0, 0.0)) {
        ALBEDO = colour2;
    }
}
"
