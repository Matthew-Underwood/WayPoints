[gd_resource type="Shader" format=2]

[resource]
code = "shader_type spatial;
render_mode unshaded, world_vertex_coords;

float circle(vec2 uvc, vec2 pos, float rad) {
    vec2 dist = uvc - pos;
    return 1.0-smoothstep(rad-(rad*0.01), rad+(rad*0.01), dot(dist, dist)*10.0);
}

vec2 createBezier(int i, vec2 p0, vec2 p1, vec2 p2) {
    float t = float(i) * 0.01;
    vec2 q0 = mix(p0, p1, t);
    vec2 q1 = mix(p1, p2, t);
    vec2 b = mix(q0, q1, t);
    return b;
}

void fragment() {
    
    vec2 uvc = UV;
    vec2 corner = vec2(1.0, 1.0);
    vec2 p0 = vec2(0.5, 1.0);
    vec2 p1 = vec2(0.5);
    vec2 p2 = vec2(1.0, 0.5);
    float circ1 = circle(uvc, p0, 0.02);
    float circ2 = circle(uvc, p1, 0.02);
    float circ3 = circle(uvc, p2, 0.02);
    float circ4 = circle(uvc, corner, 0.02);
    vec3 red = vec3(1.0, 0.0, 0.0);
    vec3 green = vec3(0.0, 1.0, 0.0);
    vec3 blue = vec3(0.0, 0.0, 1.0);
    vec3 yellow = vec3(1.0, 1.0, 0.0);
    vec3 col = circ1 * red;
    col += circ2 * green;
    col += circ3 * blue;
    col += circ4 * yellow;

    for (int i = 0;i < 100;i++) {
        vec2 b = createBezier(i, p0, p1, p2);
        col += circle(uvc, b, 0.5);
    }
    ALBEDO = col;
}
"
