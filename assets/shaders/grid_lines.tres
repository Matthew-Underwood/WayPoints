[gd_resource type="Shader" format=2]

[resource]
code = "shader_type spatial;
render_mode unshaded, world_vertex_coords;

uniform vec2 map_size;

void fragment() {

    vec2 uv = UV * map_size;
    vec2 fuv = fract(uv);
    vec2 bk = step(vec2(0.04), fuv);
    float col = bk.x * bk.y;
    vec3 line_colour = vec3(1.0, 0.0, 0.0);
    ALBEDO = line_colour;
    ALPHA = 1.0 - col;
}"
